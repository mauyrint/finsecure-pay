JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me-strong-password

GITHUB_REPO_URL=https://github.com/mauyrint/finsecure-pay.git
GITHUB_USER=mauyrint
GITHUB_TOKEN=<github-fine-grained-pat-with-contents-read>

DOCKERHUB_USER=<dockerhub-user>
DOCKERHUB_TOKEN=<dockerhub-access-token>
DOCKERHUB_REPO=docker.io/<dockerhub-user>/finsecure-pay

AWS_ACCESS_KEY_ID=<jenkins-deployer-access-key-id>
AWS_SECRET_ACCESS_KEY=<jenkins-deployer-secret>
AWS_REGION=ap-southeast-1
EKS_CLUSTER=finsecure-eks

SONAR_HOST_URL=http://sonarqube:9000
SONAR_TOKEN=<sonarqube-user-token>
NVD_API_KEY=<free key from https://nvd.nist.gov/developers/request-an-api-key>

FINSECURE_API_KEY=<random-string>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=<you@gmail.com>
SMTP_PASSWORD=<gmail-app-password>
NOTIFY_EMAIL=<you@gmail.com>
